# ── Proxy settings ──────────────────────────────────────────────────────────
HTTP_PROXY=http://g3.konicaminolta.jp:8080/
HTTPS_PROXY=http://g3.konicaminolta.jp:8080/
NO_PROXY=localhost,127.0.0.1,ollama,postgres,litellm

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=litellm_db

# ── LiteLLM ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-REPLACE_WITH_RANDOM_KEY
LITELLM_PORT=4000

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
# VRAM使用上限をバイト単位で指定 (例: 12 GB = 12884901888)
# GPU の実際の VRAM に合わせて設定してください。未設定時は Ollama が自動検出します。
# OLLAMA_MAX_VRAM=12884901888
